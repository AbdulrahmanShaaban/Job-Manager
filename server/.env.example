# ---------------------------------------------------------------------------
# Job Manager server — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins. Mobile apps send no Origin.
CORS_ORIGINS=http://localhost:5173

# Neon PostgreSQL
# Pooled endpoint (runtime). Keep sslmode=require.
DATABASE_URL=
# Direct endpoint (Prisma CLI migrations only).
DIRECT_URL=

# 32+ random bytes, e.g. `openssl rand -hex 32`
AUTH_SECRET=
# Access session lifetime in days.
SESSION_TTL_DAYS=30

# First-run owner account (used by `npm run seed`). Choose a strong password.
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_WORKSPACE_NAME=

# ---------------------------------------------------------------------------
# AI — strict $0 first. Leave blank to disable voice features gracefully.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.5-flash
# Optional free fallback (Groq Whisper + Llama). Leave blank to disable.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile
AI_MAX_SESSION_SECONDS=180
AI_MONTHLY_BUDGET_USD=0
AI_ALLOW_PAID_FALLBACK=false
TRANSCRIPT_RETENTION_ENABLED=false
# Configurable soft limits used by the usage endpoint / warnings.
AI_MONTHLY_SESSION_LIMIT=300
AI_MONTHLY_MINUTES_LIMIT=300
# Turn fallback audio limits
AI_FALLBACK_MAX_BYTES=6291456
AI_FALLBACK_MAX_SECONDS=20
