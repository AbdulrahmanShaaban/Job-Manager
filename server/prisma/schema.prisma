// Job Manager — Prisma schema (Prisma ORM 7, PostgreSQL/Neon)
// Docs: https://www.prisma.io/docs/orm/v7

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum SiteScope {
  PERSONAL
  COMPANY
}

enum SiteStatus {
  ACTIVE
  ARCHIVED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum VisitSource {
  MANUAL
  VOICE
}

enum VoiceProvider {
  GEMINI_LIVE
  FALLBACK
  NONE
}

enum VoiceSessionStatus {
  ACTIVE
  COMPLETED
  FAILED
  ABANDONED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions        Session[]
  memberships     WorkspaceMember[]
  ownedSites      Site[]            @relation("SiteOwner")
  createdSites    Site[]            @relation("SiteCreator")
  createdVisits   Visit[]
  createdTasks    Task[]            @relation("TaskCreator")
  assignedTasks   Task[]            @relation("TaskAssignee")
  voiceSessions   VoiceSession[]
  invitationsSent Invitation[]      @relation("InvitationSender")
}

/// Opaque, revocable login sessions. Only a SHA-256 hash of the bearer token is stored.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     WorkspaceMember[]
  sites       Site[]
  invitations Invitation[]
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(EDITOR)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Site {
  id              String     @id @default(uuid()) @db.Uuid
  name            String
  scope           SiteScope
  status          SiteStatus @default(ACTIVE)
  ownerUserId     String?    @db.Uuid
  workspaceId     String?    @db.Uuid
  createdById     String     @db.Uuid
  address         String
  contactName     String?
  contactPhone    String?
  mapUrl          String?
  latitude        Float?
  longitude       Float?
  generalNotes    String?
  clientOperationId String?  @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  owner     User?      @relation("SiteOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User       @relation("SiteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  visits    Visit[]
  tasks     Task[]

  @@index([scope, status])
  @@index([ownerUserId, status])
  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt(sort: Desc)])
}

/// Append-only historical record of one dated site visit.
model Visit {
  id                String      @id @default(uuid()) @db.Uuid
  siteId            String      @db.Uuid
  visitDate         DateTime    @db.Date
  completedWork     String
  remainingWork     String?
  notes             String?
  /// Optional saved transcript when the visit was prepared by voice and retention is enabled.
  transcript        String?
  source            VisitSource @default(MANUAL)
  createdById       String      @db.Uuid
  clientOperationId String?     @unique
  revision          Int         @default(1)
  editedAt          DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  site      Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([siteId, visitDate(sort: Desc)])
}

/// Live operational checklist. Deliberately separate from the visit history log.
model Task {
  id                String       @id @default(uuid()) @db.Uuid
  siteId            String?      @db.Uuid
  title             String
  description       String?
  status            TaskStatus   @default(OPEN)
  priority          TaskPriority @default(NORMAL)
  dueDate           DateTime?    @db.Date
  completedAt       DateTime?
  createdById       String       @db.Uuid
  assigneeId        String?      @db.Uuid
  clientOperationId String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  site      Site? @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy User  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignee  User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([siteId, status])
  @@index([assigneeId, status])
  @@index([createdById, status])
  @@index([dueDate])
}

/// Metadata only. Raw audio is never stored.
model VoiceSession {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @db.Uuid
  provider              VoiceProvider      @default(NONE)
  modelId               String
  status                VoiceSessionStatus @default(ACTIVE)
  summary               String?
  transcript            String?
  estimatedSeconds      Int                @default(0)
  estimatedInputTokens  Int?
  estimatedOutputTokens Int?
  errorCode             String?
  startedAt             DateTime           @default(now())
  endedAt               DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt(sort: Desc)])
}

/// Controlled, one-time workspace invitation (no open public sign-up).
model Invitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  email       String
  role        WorkspaceRole @default(EDITOR)
  tokenHash   String        @unique
  invitedById String        @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, acceptedAt])
  @@index([email])
}
